# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (он в .gitignore).
DATABASE_URL=postgresql+psycopg2://bi:bi@localhost:5432/bi

# ===== Модель: по умолчанию OpenAI-совместимый API (LLM_PROVIDER=openai) =====

# Вариант A. Модель организаторов или любой внешний сервер (vLLM, LM Studio, облачный ключ).
# Адрес обычно заканчивается на /v1. Ключ никому не пересылайте и не коммитьте.
# LLM_BASE_URL=https://<хост-организаторов>/v1
# LLM_MODEL=<точное имя модели>
# LLM_API_KEY=<ключ>
# Необязательно:
# LLM_MAX_TOKENS=2048          если сервер по умолчанию обрезает ответы
# LLM_TIMEOUT=300
# LLM_EXTRA_PARAMS={"chat_template_kwargs": {"enable_thinking": false}}   # отключение «размышлений» (vLLM); для Ollama: {"think": false}

# Вариант B. Локальная модель в контейнере Ollama (bash run.sh запустит её сам).
# В этом случае LLM_BASE_URL в .env НЕ задавайте: внутри docker адрес подставится сам (http://ollama:11434/v1).
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_NUM_CTX=8192             размер контекста и время хранения модели задаются на сервере Ollama
# LLM_KEEP_ALIVE=30m

# Вариант C. Приложение запускается без docker (uv run streamlit run app.py), Ollama на этом же компьютере:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct

# Родной API Ollama (редко нужен): LLM_PROVIDER=ollama, LLM_BASE_URL=http://localhost:11434
# Старые переменные OLLAMA_URL и OLLAMA_MODEL больше не читаются.

# ===== Скорость и поведение агента (необязательно; значения по умолчанию подходят) =====
# ROUTER_MODE=rules      намерение определяют правила, без вызова модели; llm — отдельный вызов модели для каждого вопроса
# NARRATION=auto         одиночные числа пересказываются шаблоном; llm — всегда моделью; template — никогда моделью
# CHART_LLM=0            тип графика подбирают правила; 1 — спрашивать модель (медленнее)
# HISTORY_TURNS=4        сколько последних реплик диалога попадает в запрос к модели
# SQL_MAX_TOKENS=1024    для моделей с «размышлениями» поднимите значение или отключите размышления в LLM_EXTRA_PARAMS
# DASHBOARD_MAX_WIDGETS=4
# DASHBOARD_CACHE_TTL=300  секунды хранения результатов виджетов дашборда
# Файлы от этого размера (МБ) грузятся потоково через COPY
# FAST_LOAD_MIN_MB=50